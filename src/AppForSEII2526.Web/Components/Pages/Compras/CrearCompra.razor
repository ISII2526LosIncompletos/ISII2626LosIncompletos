@page "/Compras/CrearCompra"

@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CrearCompra> Logger
@inject ComprarStateContainer comprarState


<h3>CrearCompra</h3>

@* rental is the object that will be edited thanks to the form *@
<EditForm Model="compra" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary />
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.NombreCliente" class="form-control" id="NombreCliente" />
                <label for="NombreCliente">Nombre</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.ApellidoCliente" class="form-control" id="ApellidoCliente" />
                <label for="ApellidosCliente">Apellidos</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputDate @bind-Value="compra.DireccionEnvio" class="form-control" id="DirecciónEnvío" />
                <label for="FechaEntrega">Dirección de envío</label>
            </div>
        </div>
    </div>
        <div class="col-md">
            <div class="form-floating">
                @*Este botón es para preguntar al usuario si quiere proceder a comprar una herramienta*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Comprar herramientas
                </button>
            </div>
        </div>
    
    <div class="mh-100 table-responsive">
        <table class="table table-consdensed table-hover" id="TableOfItemsCompras">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Material</th>
                    <th>Precio de compra</th>
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in compra.CompraItems)
                {
                    <tr id="HerramientaData_@item.Nombre">
                        <td>@item.Nombre</td>
                        <td>@item.Material</td>
                        <td>@item.PrecioCompra</td>
                        <td><InputText @bind-Value="item.Descripcion" class="form-control" id="@($"description_{item.HerramientaID}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>


@*Un cuadro de diálogo para preguntar al usuario si desea proceder con comprar herramientas*@
@if (DialogIsOpen)
{
    <Dialog Caption="Comprar herramientas"
            Message="Quieres proceder a la compra de las herramientas seleccionadas?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {

    private bool DialogIsOpen;
    private object? errors;
    private CompraCreacionDTO compra => comprarState.Compra;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid

        }
    }

}

   