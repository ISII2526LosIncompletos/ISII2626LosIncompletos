@page "/Compras/SeleccionarHerramientasParaComprar"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SeleccionarHerramientasParaComprar> logger
@inject ComprarStateContainer comprarStateContainer
@inject NavigationManager navigation

@attribute [Authorize]
<h3>SeleccionarHerramientasParaComprar</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@esconderErrores">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Precio</span>
                        <input type="text" id="inputPrecio" @bind=Precio class="form-control" placeholder="Precio" aria-label="Precio" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Material</span>
                        <input type="text" id="inputmaterial" @bind=Material class="form-control" placeholder="Material" aria-label="Material" aria-describedby="basic-addon1">
                    </div>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHerramientas id="BuscarHerramientas">Buscar Herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Cargando herramientas....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TablaHerramientas">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th>Precio</th>
                                    <th>Nombre</th>
                                    <th>Tiempo de Reparacion</th>
                                    <th>Fabricante</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramienta in herramientas)
                                {
                                    <tr id="HerramientaData_@herramienta.HerramientaID">
                                        <td>@herramienta.Material</td>
                                        <td>@herramienta.Precio</td>
                                        <td>@herramienta.Nombre</td>
                                        <td>@herramienta.TiempoReparacion</td>
                                        <td>@herramienta.Fabricante</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaParaComprar_@herramienta.HerramientaID" @onclick="@(() =>
                                                                                                                                                                                             AddHerramienta(herramienta))">
                                        Añadir
                                    </button>
                                </td>
                            </tr>
                                                        }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@EsconderListaCompra">
            <div class="row">
                <h3>Lista de Herramientas Compradas</h3>
            </div>
            @foreach (CompraItemDTO item in compra.CompraItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="eliminarherramientas_@item.Nombre" @onclick="@(() => EliminarHerramienta(item))">x @item.Nombre - @item.PrecioCompra€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="comprarHerramientaButton" @onclick=@HerramientasCompradas>ComprarHerramientas</button>
            </div>
        </div>

    </div>

</div>

@code {
    private bool esconderHerramientasCompradas { get { return compra.CompraItems.Count == 0; } }
    private ICollection<HerramientasDTO>? herramientas;
    private bool esconderErrores { get { return errors.Length == 0; } }
    private string errors = "";
    private string? Material { get; set; }
    private double? Precio { get; set; }

    private CompraCreacionDTO compra => comprarStateContainer.Compra;

    private bool EsconderListaCompra = true;

    private void AddHerramienta(HerramientasDTO herramienta)
    {
        comprarStateContainer.AddHerramienta(herramienta);
    }

    private void EliminarHerramienta(CompraItemDTO item)
    {
        comprarStateContainer.EliminarHerramienta(item);
        if (compra.CompraItems.Count == 0) EsconderListaCompra = true;
    }

    public async void BuscarHerramientas()
    {
        if (Precio == null)
        {
            Precio = null;
        }

        try
        {
            herramientas = await apiclient.GetComprasAsync(Material, Precio);
            errors = "";

        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error mientras se conectaba al sistema";
        }
        StateHasChanged();
    }
    protected override Task OnInitializedAsync()
    {
        BuscarHerramientas();
        return base.OnInitializedAsync();
    }
    private void HerramientasCompradas()
    {
        navigation.NavigateTo("/Compras/CrearCompra");
    }
}
