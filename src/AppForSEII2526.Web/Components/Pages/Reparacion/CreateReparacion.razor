@page "/reparacion/createreparacion"

@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateReparacion> logger
@inject RepararStateContainer repararState

<h3>Create Reparacion</h3>

@* La reparación es el objeto que se editará gracias al formulario *@
<EditForm Model="reparacion" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary/>
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errores: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="reparacion.NombreCliente" class="form-control" id="NombreCliente" />
                <label for="NombreCliente">Nombre</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="reparacion.ApellidoCliente" class="form-control" id="ApellidoCliente" />
                <label for="ApellidosCliente">Apellidos</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputDate @bind-Value="reparacion.FechaEntrega" class="form-control" id="FechaEntrega" />
                <label for="FechaEntrega">Fecha entrega</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*Menú desplegable para seleccionar el método de pago*@
                <InputSelect class="form-select" @bind-Value="@reparacion.MetodoPago" id="MetodoPago">
                    <option value="@TiposMetodosPago.TarjetaCredito" default> Tarjeta de crédito</option>
                    <option value="@TiposMetodosPago.PayPal"> PayPal</option>
                    <option value="@TiposMetodosPago.Efectivo"> Efectivo</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                @* Este botón se utilizará para preguntar al usuario si desea proceder a la reparación de las herramientas *@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Reparar herramientas
                </button>
            </div>
        </div>
    </div>
    <h4>Detalles reparación</h4>
    @{
        var maxDias = (reparacion.ItemsReparacion != null && reparacion.ItemsReparacion.Any())
        ? reparacion.ItemsReparacion.Max(r => r.TiempoReparacion) : 0;
    }
    <p><b>Fecha entrega:</b> @reparacion.FechaEntrega.ToString("dd/MM/yyyy") <b>Fecha recogida:</b> @reparacion.FechaEntrega.AddDays(maxDias).ToString("dd/MM/yyyy")</p>
    <p>
        <b>Precio total:</b> @PrecioTotal€
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyItemsReparacion" id="ModifyHerramientas">
            Modificar herramientas
        </button>
    </p>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfItemsReparacion">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                    <th>Tiempo de reparación</th>
                    <th>Precio de reparación</th>
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in reparacion.ItemsReparacion)
                {
                    <tr id="MovieData_@item.Nombre">
                        <td>@item.Nombre</td>
                        <td><InputNumber @bind-value="item.Cantidad" class="form-control" id="@($"cantidad_{item.Nombre}")" /></td>
                        <td>@item.TiempoReparacion</td>
                        <td>@item.PrecioReparacion</td>
                        <td><InputText @bind-Value="item.Descripcion" class="form-control" id="@($"description_{item.Nombre}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*Un cuadro de diálogo emergente modal para verificar si el usuario desea continuar con la reparación*@
@if (DialogIsOpen)
{
    <Dialog Caption="Reparar herramientas"
            Message="¿Quieres proceder a la reparación de las herramientas seleccionadas?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;

    private decimal PrecioTotal
    {
        get
        {
            if (reparacion?.ItemsReparacion == null || !reparacion.ItemsReparacion.Any()) return 0m;
            int numDias = reparacion.ItemsReparacion.Max(item => item.TiempoReparacion); //recogida
            //int numDias = (reparacion.FechaEntrega.DateTime - reparacion.FechaEntrega.AddDays(recogida).DateTime).Days;
            double precio = reparacion.ItemsReparacion.Sum(ri => ri.PrecioReparacion * numDias);
            return Convert.ToDecimal(precio);
        }
    }
    private void ModifyItemsReparacion()
    {
        navigation.NavigateTo("/reparacion/selectherramentasparareparar");
    }

    private ReparacionCreacionDTO reparacion => repararState.Reparacion;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (reparacion.ItemsReparacion.Count > 0)
            {
                try
                {
                    var reparado = await apiclient.CrearReparacionAsync(reparacion);
                    repararState.ReparacionProcessed();
                    navigation.NavigateTo($"/reparacion/reparaciondetalle/?ReparacionID={reparado.ReparacionId}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //Necesitamos informar al usuario que se produjeron otros errores al procesar la solicitud
                    messageError = "Error al procesar su pedido. Por favor, intentelo más tarde";
                }
            }
        }
    }


}
