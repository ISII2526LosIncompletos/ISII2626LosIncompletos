            "type": "integer",
            "format": "int32"
          },
          "nombreCliente": {
            "type": "string",
            "nullable": true
          },
          "apellidoCliente": {
            "type": "string",
            "nullable": true
          },
          "direccionEnvio": {
            "type": "string",
            "nullable": true
          },
          "precioTotal": {
            "type": "number",
            "format": "double"
          },
          "fechaCompra": {
            "type": "string",
            "format": "date-time"
          },
          "compraItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompraItemDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CompraItemDTO": {
        "type": "object",
