  "components": {
    "schemas": {
      "CompraCreacionDTO": {
        "required": [
          "apellidoCliente",
          "compraItems",
          "direccionEnvio",
          "fechaCompra",
          "metodoPago",
          "nombreCliente"
        ],
        "type": "object",
        "properties": {
          "nombreCliente": {
            "maxLength": 20,
            "minLength": 0,
            "pattern": "^[A-Z]+[a-zA-Z''-'\\s]*$",
            "type": "string"
          },
          "apellidoCliente": {
            "maxLength": 40,
            "minLength": 0,
            "pattern": "^[A-Z]+[a-zA-Z''-'\\s]*$",
            "type": "string"
          },
          "direccionEnvio": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[\\p{L}0-9\\s\\.,#\\-]+$",
            "type": "string"
          },
          "metodoPago": {
            "$ref": "#/components/schemas/tiposMetodosPago"
          },
          "numTelefono": {
            "maxLength": 9,
            "minLength": 0,
            "pattern": "^\\d{9}$",
            "type": "string",
            "nullable": true
          },
          "correoElectronico": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "fechaCompra": {
            "type": "string",
            "format": "date"
          },
          "compraItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompraItemDTO"
            }
          },
          "PrecioTotal": {
            "type": "number",
            "format": "double",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
