          "herramientaID": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "material": {
            "type": "string",
            "nullable": true
          },
          "precioCompra": {
            "type": "number",
            "format": "double"
          },
          "cantidad": {
            "type": "integer",
            "format": "int32"
          },
          "descripcion": {
